# Copy this file to .env.local and fill in values before running docker compose.
# .env.local is git-ignored and never committed.

# Bedrock Knowledge Base the backend queries (AWS Console → Bedrock → Knowledge Bases)
# For the UI date filter to pre-filter inside the vector search, the KB must
# index the scraper's .metadata.json sidecar attributes (date_numeric etc.) —
# i.e. a KB with its own vector store such as an S3 Vectors index. Managed KBs
# ignore sidecars; the backend then post-filters and excludes undated chunks.
KNOWLEDGE_BASE_ID=

# Generation model, invoked via the bedrock-runtime Converse API after KB retrieval.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# KB_NUM_RESULTS=8

# Optional Bedrock Guardrail applied to answer generation. Use the guardrail's
# ID or ARN (Console → Bedrock → Guardrails → your guardrail), NOT its name.
# GUARDRAIL_VERSION is "DRAFT" or a published version number (default DRAFT).
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=DRAFT

# AWS credentials — use ONE of the two approaches below:

# Approach A: named profile (matches the ~/.aws/credentials profile you use for CDK)
AWS_PROFILE=terraform

# Approach B: explicit keys (useful in CI or when no profile is configured)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_DEFAULT_REGION=us-east-1

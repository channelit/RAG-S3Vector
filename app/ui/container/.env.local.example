# Copy this file to .env.local and fill in values before running docker compose.
# .env.local is git-ignored and never committed.

# Bedrock Knowledge Base the backend queries (KB ID, not name — Console →
# Bedrock → Knowledge Bases). Each question is ONE RetrieveAndGenerate call:
# the KB retrieves the chunks and Bedrock writes the answer from them.
# NOTE: RetrieveAndGenerate is rejected by MANAGED knowledge bases
# ("This operation is not supported for managed knowledge bases") — the KB
# must be a standard one (e.g. S3 Vectors-backed with an S3 data source).
#
# Date filtering: a `date_numeric` (YYYYMMDD) metadata filter — the attribute
# the scraper writes into each document's .metadata.json sidecar — is passed
# in the retrieval configuration and enforced by the KB's vector store. That
# sidecar attribute is the only date source; there is no post-filtering.
#
# `cdk deploy` (iac/) creates this KB and prints its ID as the KnowledgeBaseId
# output; the ContainerUiEnv output is a paste-ready copy of the four
# KNOWLEDGE_BASE_ID / BEDROCK_MODEL_ARN / GUARDRAIL_ID / GUARDRAIL_VERSION lines.
KNOWLEDGE_BASE_ID=
# Its S3 data source (KnowledgeBaseDataSourceId output). Only backend/kb_report.py
# reads this; it falls back to the KB's sole data source when unset.
# KB_DATA_SOURCE_ID=

# Generation model: a full ARN, a cross-region inference-profile ID (us./eu./
# apac./global. prefix — required for Claude Sonnet 4.6, which has no on-demand
# foundation-model access) or a bare foundation model ID.
# BEDROCK_MODEL_ARN=us.anthropic.claude-sonnet-4-6

# Passages retrieved per query.
# KB_NUM_RESULTS=8

# Sources are taken from the response citations and returned as {label, url}:
# CSMS message text links to its public GovDelivery bulletin, attachments to
# their sidecar attachment_url when the KB exposes sidecar metadata.

# Bedrock Guardrail applied to generation (sources are suppressed when it
# intervenes). Use the guardrail's ID, NOT its name. The CDK stack creates one
# with content filters + PII policy and prints GuardrailId / GuardrailVersion
# (a pinned published version) — use those rather than DRAFT. Leave unset to
# run without a guardrail.
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=1

# ALTCHA proof-of-work captcha (https://altcha.org), self-hosted: this backend
# creates and verifies challenges itself with the `altcha` library and serves
# them to the widget at the relative path /api/altcha/challenge — there is no
# separate ALTCHA server. While enabled, Submit stays disabled until the widget
# solves a challenge, and /api/query rejects requests without a valid payload.
#
# On by default; set to false to run without a captcha.
# ALTCHA_ENABLED=true
# HMAC key that signs/verifies challenges. Generate: openssl rand -hex 32
# Unset = a random key per process: fine for this single local container, but
# set it whenever there is more than one worker/replica.
# ALTCHA_HMAC_KEY=
# Algorithm (PBKDF2/SHA-256, PBKDF2/SHA-512, SHA-256, ...), cost (iterations per
# attempt) and challenge lifetime in seconds.
# ALTCHA_ALGORITHM=PBKDF2/SHA-256
# ALTCHA_COST=5000
# ALTCHA_EXPIRES_SECONDS=300

# AWS credentials — use ONE of the two approaches below:

# Approach A: named profile (matches the ~/.aws/credentials profile you use for CDK)
AWS_PROFILE=terraform

# Approach B: explicit keys (useful in CI or when no profile is configured)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_DEFAULT_REGION=us-east-1

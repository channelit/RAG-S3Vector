# Copy this file to .env.local and fill in values before running docker compose.
# .env.local is git-ignored and never committed.

# Bedrock Knowledge Base the backend queries (KB ID, not name — Console →
# Bedrock → Knowledge Bases). Retrieval is bedrock-agent-runtime retrieve();
# the answer is then written with bedrock-runtime converse().
#
# Date filtering: a `date_numeric` (YYYYMMDD) metadata filter — the attribute
# the scraper writes into each document's .metadata.json sidecar — is passed to
# retrieve(). A KB whose vector store indexes sidecar attributes (e.g. an
# S3 Vectors-backed KB) enforces the range natively; a managed KB ignores
# sidecars, so results are post-filtered and undated chunks are dropped.
KNOWLEDGE_BASE_ID=

# Generation model for converse() (model ID, inference profile, or full ARN).
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Passages retrieved per query. When the KB can't enforce the date filter
# natively the backend fetches deeper (max(KB_NUM_RESULTS, 25)) so the
# post-filter still has candidates.
# KB_NUM_RESULTS=8

# Sources are returned as {label, url}: CSMS message text links to its public
# GovDelivery bulletin, archive-derived pages to their fetched URL, and any
# other S3 object (attachments, standalone PDFs) to a presigned GET link.
# SOURCE_URL_TTL_SECONDS=3600     # presigned link lifetime

# Optional Bedrock Guardrail applied to every converse() call. Use the
# guardrail's ID or ARN (Console → Bedrock → Guardrails → your guardrail),
# NOT its name. GUARDRAIL_VERSION is "DRAFT" or a published version number.
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=DRAFT

# AWS credentials — use ONE of the two approaches below:

# Approach A: named profile (matches the ~/.aws/credentials profile you use for CDK)
AWS_PROFILE=terraform

# Approach B: explicit keys (useful in CI or when no profile is configured)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_DEFAULT_REGION=us-east-1

# Copy this file to .env.local and fill in values before running docker compose.
# .env.local is git-ignored and never committed.

# S3 Vectors store the backend queries directly (same one the ingestion/query
# Lambdas use — see the VectorBucketName/VectorIndexName CfnOutputs of the CDK
# stack, e.g. cits-rag-s3vector-vectors-cits001 / cits-rag-s3vector-index).
VECTOR_BUCKET_NAME=
VECTOR_INDEX_NAME=

# Bedrock embedding model — must match what the ingestion Lambda used
# (iac/config/common.yml bedrock.embedding_model_id).
# EMBEDDING_MODEL_ID=amazon.nova-2-multimodal-embeddings-v1:0

# Generation model for the Converse tool loop — must support Converse tool use
# (model ID, inference profile, or full ARN).
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Documents bucket the ingestion Lambda reads from (DocumentBucketName CfnOutput,
# e.g. cits-rag-s3vector-documents-cits001). When set, source citations that
# have no public URL (attachments, standalone PDFs) are returned as presigned
# S3 links; CSMS message text always links to its public GovDelivery bulletin.
# DOCUMENTS_BUCKET_NAME=
# SOURCE_URL_TTL_SECONDS=3600     # presigned link lifetime

# Optional Bedrock Knowledge Base for search_messages (KB ID, not name). When
# set, retrieval uses bedrock-agent-runtime `retrieve` on this KB instead of the
# S3 Vectors index; generation, the guardrail, and count_messages are unchanged.
# The KB must be synced from the same documents bucket so dates can be resolved.
# KNOWLEDGE_BASE_ID=

# Retrieval and loop tuning.
# SEARCH_TOP_K=8                 # passages returned per search_messages call
# MANIFEST_TTL_SECONDS=600       # how long the in-memory corpus manifest is reused
# MAX_TOOL_TURNS=8               # max converse round-trips per question

# Optional Bedrock Guardrail applied to every converse() call. Use the
# guardrail's ID or ARN (Console → Bedrock → Guardrails → your guardrail),
# NOT its name. GUARDRAIL_VERSION is "DRAFT" or a published version number.
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=DRAFT

# AWS credentials — use ONE of the two approaches below:

# Approach A: named profile (matches the ~/.aws/credentials profile you use for CDK)
AWS_PROFILE=terraform

# Approach B: explicit keys (useful in CI or when no profile is configured)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_DEFAULT_REGION=us-east-1

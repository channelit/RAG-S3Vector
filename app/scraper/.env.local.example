# Copy this file to .env.local and fill in values before running docker compose.
# .env.local is git-ignored and never committed.

# `cdk deploy` (iac/) prints a ScraperEnv output: a paste-ready copy of the
# S3_BUCKET_NAME, S3_PREFIX, KNOWLEDGE_BASE_ID, KB_DATA_SOURCE_ID and SUMMARY_*
# lines below.

# Destination bucket: the stack's documents bucket, which the Knowledge Bases'
# S3 data sources read.
S3_BUCKET_NAME=cits-rag-s3vector-documents-<unique_id>

# Key prefix for the messages: the message Knowledge Base's source prefix
# (knowledge_base.source_prefix in iac/config/common.yml). Default csms/
S3_PREFIX=csms/1/

# The Bedrock Knowledge Base and its S3 data source that index the messages
# above. IDs, not names (Console → Bedrock → Knowledge Bases → your KB → Data
# sources). When both are set, the scraper syncs the data source after a run
# that uploaded messages (--no-sync skips it); `reindex` mode / POST /reindex /
# --reindex need them. Unset = the scraper only uploads.
# KNOWLEDGE_BASE_ID=
# KB_DATA_SOURCE_ID=

# Collection summary: statistics documents (message counts by date, country and
# attachments) rebuilt after every run that uploaded messages, and by
# `python -m scraper summary`. Unset = no summary is written.
# SUMMARY_PREFIX is the summary Knowledge Base's source prefix
# (knowledge_base.additional.summary.source_prefix); it must not overlap S3_PREFIX.
# SUMMARY_PREFIX=csms-summary/1/
# Optional: the summary Knowledge Base and its S3 data source (IDs). When both
# are set, the scraper syncs that data source after writing the documents.
# SUMMARY_KNOWLEDGE_BASE_ID=
# SUMMARY_KB_DATA_SOURCE_ID=

# AWS credentials — use ONE of the two approaches below:

# Approach A: named profile (matches the ~/.aws/credentials profile you use for CDK)
AWS_PROFILE=terraform

# Approach B: explicit keys (useful in CI or when no profile is configured)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_DEFAULT_REGION=us-east-1

# Politeness knobs (optional)
# REQUEST_DELAY_SECONDS=0.7
# REQUEST_TIMEOUT_SECONDS=30
# MAX_RETRIES=3
